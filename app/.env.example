# Copier en `.env`. Les variables préfixées EXPO_PUBLIC_ sont injectées dans le
# bundle : n'y mettre aucun secret.

# Web et simulateur iOS : localhost fonctionne.
# Sur un appareil physique, remplacer par l'IP de la machine de développement,
# par exemple http://192.168.1.20:8010/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8010/api/v1
