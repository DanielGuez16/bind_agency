  "motion": {
    "durationFast": 120,
    "durationBase": 200,
    "durationSlow": 320,
    "skeletonLoop": 1400,
    "easing": "ease-out",
    "animatableProps": [
      "opacity",
      "transform"
    ]
  },
  "code": {
    "chars": 6,
    "alphabet": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
    "fg": "#FFFFFF",
    "bg": "#000000",
    "contrast": "21:1",
    "codeFontSize": 76,
    "countdownFontSize": 46,
    "countdownUrgentBelowSeconds": 10,
    "forceMaxBrightness": true,
    "keepAwake": true,
    "manualChars": 6,
    "manualGroupSize": 3,
    "rotationSeconds": 30,
    "ignoresTheme": true
  },
  "theme": {
    "defaultByRole": {
      "creator": "light",
      "merchant": "light"
    },
    "userOverride": true,
    "exceptions": {
      "pickupCodeScreen": "ignores theme, always #FFFFFF on #000000",
      "salonGallery": "plein écran sur bg.sunken du thème sombre : une photo se regarde sur du sombre"
    }
  },
  "tier": {
    "order": [
      "story",
      "post",
      "reel"
    ],
    "story": {
      "level": 1,
      "label": {
        "en": "STORY",
        "es": "HISTORIA"
      },
      "glyphBars": 1,
      "material": "outline",
      "minFollowers": 1000,
      "counterpart": {
        "en": "One story within 48 h",
        "es": "Una historia en 48 h"
      }
    },
    "post": {
      "level": 2,
      "label": {
        "en": "POST",
        "es": "PUBLICACIÓN"
      },
      "glyphBars": 2,
      "material": "solidAccent",
      "minFollowers": 10000,
      "counterpart": {
        "en": "One feed post within 48 h",
        "es": "Una publicación en 48 h"
      }
    },
    "reel": {
      "level": 3,
      "label": {
        "en": "REEL",
        "es": "REEL"
      },
      "glyphBars": 3,
      "material": "solidInverse",
      "minFollowers": 50000,
      "counterpart": {
        "en": "One dedicated reel within 72 h",
        "es": "Un reel dedicado en 72 h"
      }
    },
    "rules": [
      "mot toujours écrit, jamais abrégé",
      "glyphe de 1 à 3 barres (heights 6/9/12, width 3, gap 2)",
      "badge sur photo posé sur badge.scrim",
      "aucune couleur seule porteuse de sens",
      "jamais de chiffre de niveau dans le badge"
    ]
  },
  "badge": {
    "newcomer": {
      "label": {
        "en": "New on BIND",
        "es": "Nuevo en BIND"
      },
      "expires": "21 jours ou 3 publications livrées",
      "audience": "commerce",
      "neverShowsZero": true
    },
    "behaviour": {
      "examples": [
        "12 publications livrées",
        "Habitué · {salon}",
        "Toujours dans les délais"
      ],
      "cumulative": true,
      "neverDecreases": true
    },
    "maxVisible": 2,
    "priority": [
      "behaviour",
      "newcomer"
    ],
    "negativeBadges": "aucun"
  }
}
