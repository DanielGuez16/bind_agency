  "breakpoint": {
    "compact": 0,
    "medium": 600,
    "expanded": 900,
    "contentMaxCreator": 1120,
    "contentMaxMerchant": 720,
    "contentMaxReports": 1120,
    "listWidthMerchant": 400,
    "sidebarWidth": 240,
    "sidebarRailWidth": 72,
    "detailPanelAdmin": 440,
    "topBarHeight": 56
