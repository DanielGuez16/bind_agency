{
  "$meta": {
    "name": "BIND · After Hours (retenue, v0.2)",
    "defaultTheme": "dark",
    "platform": "react-native + expo web",
    "version": "0.3.0",
    "changelog": [
      "v0.2 · thème clair par défaut en rôle commerce (lisibilité plein jour), role.merchant décliné par thème",
      "v0.2 · badge de rang individuel remplacé par badge de vague",
      "v0.2 · paliers : glyphe à barres + mot obligatoire, chiffres de niveau retirés",
      "v0.2.1 · thème clair : accent #0A7364 et text.muted #5A6463 pour tenir AA (contraste ≥4.5) y compris sur libellés 11-18 px",
      "v0.3 · code de retrait aligné sur l'API : six chiffres tournant toutes les 30 s, sans renouvellement, plus un code de secours de six caractères ; badge de vague retiré faute de concept en base ; codes d'obstacle alignés sur les codes serveur"
    ]
  },
  "typography": {
    "fontFamily": {
      "display": "Familjen Grotesk",
      "ui": "IBM Plex Sans",
      "mono": "IBM Plex Mono"
    },
    "scale": {
      "type.display": {
        "fontFamily": "display",
        "fontSize": 34,
        "lineHeight": 38,
        "fontWeight": "600",
        "letterSpacing": -0.3
      },
      "type.title": {
        "fontFamily": "display",
        "fontSize": 24,
        "lineHeight": 30,
        "fontWeight": "600"
      },
      "type.heading": {
        "fontFamily": "ui",
        "fontSize": 18,
        "lineHeight": 24,
        "fontWeight": "600"
      },
      "type.body": {
        "fontFamily": "ui",
        "fontSize": 15,
        "lineHeight": 23,
        "fontWeight": "400"
      },
      "type.bodyStrong": {
        "fontFamily": "ui",
        "fontSize": 15,
        "lineHeight": 23,
        "fontWeight": "600"
      },
      "type.label": {
        "fontFamily": "ui",
        "fontSize": 13,
        "lineHeight": 18,
        "fontWeight": "600"
      },
      "type.caption": {
        "fontFamily": "ui",
        "fontSize": 12,
        "lineHeight": 17,
        "fontWeight": "400"
      },
      "type.mono": {
        "fontFamily": "mono",
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": "500",
        "letterSpacing": 0.8
      },
      "type.code": {
        "fontFamily": "mono",
        "fontSize": 76,
        "lineHeight": 76,
        "fontWeight": "600",
        "letterSpacing": 1.5
      },
      "type.countdown": {
        "fontFamily": "mono",
        "fontSize": 46,
        "lineHeight": 46,
        "fontWeight": "600"
      }
    }
  },
  "radius": {
    "radius.sm": 6,
    "radius.md": 8,
    "radius.lg": 12,
    "radius.xl": 16,
    "radius.full": 999
  },
  "elevation": {
    "elevation.0": {
      "ios": null,
      "android": {
        "elevation": 0
      },
      "border": true
    },
    "elevation.1": {
      "ios": {
        "shadowColor": "#000000",
        "shadowOffset": {
          "width": 0,
          "height": 1
        },
        "shadowOpacity": 0.5,
        "shadowRadius": 2
      },
      "android": {
        "elevation": 2
      }
    },
    "elevation.2": {
      "ios": {
        "shadowColor": "#000000",
        "shadowOffset": {
          "width": 0,
          "height": 4
        },
        "shadowOpacity": 0.55,
        "shadowRadius": 10
      },
      "android": {
        "elevation": 6
      }
    }
  },
