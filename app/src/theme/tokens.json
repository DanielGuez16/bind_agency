  },
  "spacing": {
    "space.1": 4,
    "space.2": 8,
    "space.3": 12,
    "space.4": 16,
    "space.5": 20,
    "space.6": 24,
    "space.8": 32,
    "space.10": 40,
    "space.12": 48,
    "space.16": 64
  },
  "density": {
    "creator": {
      "screenPadding": 20,
      "cardGap": 16,
      "rowHeight": 76
    },
    "merchant": {
      "screenPadding": 16,
      "rowGap": 8,
      "rowHeight": 64
    }
  },
  "size": {
    "control": {
      "sm": 36,
      "md": 48,
      "lg": 56
    },
    "tapMin": 44,
    "icon": 24,
    "iconStroke": 1.75
  },
  "breakpoint": {
    "compact": 0,
    "medium": 600,
    "expanded": 900,
    "contentMaxCreator": 760,
    "listWidthMerchant": 400
  },
  "motion": {
    "durationFast": 120,
    "durationBase": 200,
    "durationSlow": 320,
    "skeletonLoop": 1400,
    "easing": "ease-out",
    "animatableProps": [
      "opacity",
      "transform"
    ]
  },
  "code": {
    "chars": 6,
    "alphabet": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
    "fg": "#FFFFFF",
    "bg": "#000000",
    "contrast": "21:1",
    "codeFontSize": 76,
    "countdownFontSize": 46,
    "countdownUrgentBelowSeconds": 10,
    "forceMaxBrightness": true,
    "keepAwake": true,
    "manualChars": 6,
    "manualGroupSize": 3,
    "rotationSeconds": 30,
    "ignoresTheme": true
  },
  "theme": {
    "defaultByRole": {
      "creator": "dark",
      "merchant": "light"
    },
    "userOverride": true,
    "exceptions": {
      "pickupCodeScreen": "ignores theme, always #FFFFFF on #000000"
    }
  },
  "tier": {
    "order": [
      "story",
      "post",
      "reel"
    ],
    "story": {
      "level": 1,
      "label": {
        "en": "STORY",
        "es": "HISTORIA"
      },
      "glyphBars": 1,
      "material": "outline",
      "minFollowers": 1000,
      "counterpart": {
        "en": "One story within 48 h",
        "es": "Una historia en 48 h"
      }
    },
    "post": {
      "level": 2,
      "label": {
        "en": "POST",
        "es": "PUBLICACIÓN"
      },
      "glyphBars": 2,
      "material": "solidAccent",
      "minFollowers": 10000,
      "counterpart": {
        "en": "One feed post within 48 h",
        "es": "Una publicación en 48 h"
      }
    },
    "reel": {
      "level": 3,
      "label": {
        "en": "REEL",
        "es": "REEL"
      },
      "glyphBars": 3,
      "material": "solidInverse",
      "minFollowers": 50000,
      "counterpart": {
        "en": "One dedicated reel within 72 h",
        "es": "Un reel dedicado en 72 h"
      }
    },
    "rules": [
      "mot toujours écrit, jamais abrégé",
      "glyphe de 1 à 3 barres (heights 6/9/12, width 3, gap 2)",
      "badge sur photo posé sur badge.scrim",
      "aucune couleur seule porteuse de sens",
      "jamais de chiffre de niveau dans le badge"
    ]
  },
  "badge": {
    "newcomer": {
      "label": {
        "en": "New on BIND",
        "es": "Nuevo en BIND"
      },
      "expires": "21 jours ou 3 publications livrées",
      "audience": "commerce",
      "neverShowsZero": true
    },
    "behaviour": {
      "examples": [
        "12 publications livrées",
        "Habitué · {salon}",
        "Toujours dans les délais"
      ],
      "cumulative": true,
      "neverDecreases": true
    },
    "maxVisible": 3,
    "priority": [
      "behaviour",
      "wave",
      "newcomer"
    ],
    "negativeBadges": "aucun"
  }
}
