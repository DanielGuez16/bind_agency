# Copier en `.env` puis ajuster. `.env` n'est jamais commité.
# Aucune de ces variables n'a de valeur de repli dans le code : une variable
# absente fait échouer le démarrage plutôt que de basculer sur un défaut muet.

ENVIRONMENT=local

# Base de développement. Port 5434 : 5432 et 5433 sont déjà pris par d'autres
# conteneurs sur cette machine, le docker-compose les évite.
DATABASE_URL=postgresql+psycopg://bind:bind@localhost:5434/bind

# Base de test, créée et détruite par la session pytest. Doit être distincte de
# DATABASE_URL, conftest.py refuse de démarrer sinon.
TEST_DATABASE_URL=postgresql+psycopg://bind:bind@localhost:5434/bind_test

# Origines autorisées pour l'app Expo (web). Séparées par des virgules.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Clé de signature des jetons. AUCUNE VALEUR DE REPLI DANS LE CODE : si cette
# variable est absente, l'application refuse de démarrer, elle ne bascule pas
# sur un défaut. La CI en génère une par exécution, elle n'est fixée nulle part.
# Portée par un SecretStr : sa valeur n'apparaît ni dans un repr ni dans une trace.
# En générer une avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changez-moi-en-local-et-jamais-cette-valeur-en-production
JWT_ALGORITHM=HS256

# Durées de vie, en secondes. Accès court, rafraîchissement long et révocable.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Chiffrement des jetons OAuth au repos. AUCUNE VALEUR DE REPLI : sans elle,
# l'application refuse de démarrer. 32 octets en base64 url-safe.
# En générer une : python -c "from app.core.encryption import generate_key; print(generate_key())"
TOKEN_ENCRYPTION_KEY=changez-moi-32-octets-en-base64-url-safe=
# Écrit dans chaque valeur chiffrée. Pour changer de clé : ajouter la nouvelle,
# déplacer cet identifiant, et garder l'ancienne ci-dessous le temps qu'un
# travail de fond réécrive les valeurs.
TOKEN_ENCRYPTION_KEY_ID=v1
# Clés encore acceptées en déchiffrement, « identifiant:clé » séparés par des virgules.
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Application Meta. Facultatives : sans elles, l'API démarre et le parcours
# Instagram répond 503 plutôt que d'échouer chez Meta avec un message à eux.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:8010/api/v1/social-accounts/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic

# Durée de vie de l'état OAuth, en secondes.
OAUTH_STATE_TTL_SECONDS=600

# Fraîcheur maximale d'un relevé de métriques, en secondes. Sept jours.
METRICS_MAX_AGE_SECONDS=604800

# Intervalle minimal entre deux relevés d'un même compte, en secondes. Une heure.
# Sans lui, un bouton de rafraîchissement dans l'app devient un moyen de nous
# faire bannir de l'API de la plateforme.
METRICS_MIN_REFRESH_INTERVAL_SECONDS=3600

# Seuils de la vérification de cohérence d'un compte social, SPEC.md §3.2.
# Aucun signal n'est en dur dans le code : ce sont ces valeurs qu'on ajustera en
# voyant la file d'administration se remplir.
VERIFICATION_MIN_MEDIA_COUNT=12
VERIFICATION_MAX_FOLLOWERS_PER_MEDIA=2000
VERIFICATION_REGULARITY_WINDOW_DAYS=21
VERIFICATION_MIN_MEDIA_IN_WINDOW=1
VERIFICATION_MIN_ENGAGEMENT_RATE=0.005
VERIFICATION_MAX_ENGAGEMENT_RATE=0.25
