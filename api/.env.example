# Copier en `.env` puis ajuster. `.env` n'est jamais commité.
# Aucune de ces variables n'a de valeur de repli dans le code : une variable
# absente fait échouer le démarrage plutôt que de basculer sur un défaut muet.

ENVIRONMENT=local

# Base de développement. Port 5434 : 5432 et 5433 sont déjà pris par d'autres
# conteneurs sur cette machine, le docker-compose les évite.
DATABASE_URL=postgresql+psycopg://bind:bind@localhost:5434/bind

# Base de test, créée et détruite par la session pytest. Doit être distincte de
# DATABASE_URL, conftest.py refuse de démarrer sinon.
TEST_DATABASE_URL=postgresql+psycopg://bind:bind@localhost:5434/bind_test

# Origines autorisées pour l'app Expo (web). Séparées par des virgules.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Fournisseurs -----------------------------------------------------------
#
# Chaque intégration a son mode déclaré. Aucun n'est un repli silencieux : le
# démarrage vérifie la configuration et refuse plutôt que de basculer.

# Plateformes sociales. `demo` répond de mémoire et n'appelle personne : c'est
# le mode du développement et de la démonstration, et il emprunte le même
# parcours OAuth que le vrai. `live` exige les identifiants ci-dessous.
#
# Ce sont les deux seules valeurs. Un nom de plateforme — `instagram` — fait
# refuser le démarrage : le fournisseur se choisit par le mode, la plateforme
# se choisit par la route appelée.
SOCIAL_PROVIDER=demo

# Les schémas d'adresse vers lesquels le rappel OAuth accepte de renvoyer.
#
# Le rappel arrive sur le serveur, pas sur le téléphone : c'est le serveur qui
# ramène la personne dans l'application, en redirigeant vers l'adresse qu'elle
# a fournie en ouvrant le parcours. Une adresse fournie par le client et suivie
# sans contrôle est une redirection ouverte, d'où la liste fermée. `exp` est
# Expo Go, `bind` le schéma de l'application compilée.
OAUTH_RETURN_SCHEMES=exp,bind

# Dépôt d'objets — photos et preuves. `local` écrit sur le disque : c'est le
# seul mode où une photo posée par le jeu de données reste consultable après
# la fin de la commande. `memory` ne survit pas au processus, il n'a de sens
# qu'en test. `s3` refuse de démarrer tant qu'il n'est pas branché.
OBJECT_STORE_PROVIDER=local
OBJECT_STORE_LOCAL_ROOT=/tmp/bind-objets

# Mode `s3` : **deux compartiments distincts**, jamais un seul avec un filtre de
# préfixe. Un compartiment public s'énumère — qui connaît son adresse en liste
# le contenu — donc les preuves n'y vont jamais, et filtrer côté API n'y
# changerait rien : la route serait protégée, le compartiment non.
#
# Les photos de salon et de prestation sont publiques, c'est acté. Les preuves
# ne se lisent qu'à travers l'API, par une adresse signée de courte durée.
OBJECT_STORE_BUCKET_PUBLIC=
OBJECT_STORE_BUCKET_PRIVE=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=auto
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_SIGNED_URL_SECONDS=300

# La base que le jeu de données accepte de détruire, nommée explicitement.
# Exigée sur les environnements dont la base est distante — la démonstration —
# et inutile en local, où la base est sur la machine qui lance la commande.
SEED_DATABASE_NAME=

# Abonnement du commerce. `log` n'appelle personne et trace ce qu'il aurait
# fait. `stripe` fonctionne avec une clé de test, sans entité juridique.
BILLING_PROVIDER=log
# STRIPE_SECRET_KEY=sk_test_...

# TikTok, en bac à sable : l'application ne sert que les comptes inscrits
# comme testeurs tant qu'elle n'est pas revue. Laisser vide sans identifiants.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://localhost:8010/api/v1/social-accounts/tiktok/callback
TIKTOK_SANDBOX=true

# Clé de signature des jetons. AUCUNE VALEUR DE REPLI DANS LE CODE : si cette
# variable est absente, l'application refuse de démarrer, elle ne bascule pas
# sur un défaut. La CI en génère une par exécution, elle n'est fixée nulle part.
# Portée par un SecretStr : sa valeur n'apparaît ni dans un repr ni dans une trace.
# En générer une avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changez-moi-en-local-et-jamais-cette-valeur-en-production
JWT_ALGORITHM=HS256

# Durées de vie, en secondes. Accès court, rafraîchissement long et révocable.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Chiffrement des jetons OAuth au repos. AUCUNE VALEUR DE REPLI : sans elle,
# l'application refuse de démarrer. 32 octets en base64 url-safe.
# En générer une : python -c "from app.core.encryption import generate_key; print(generate_key())"
TOKEN_ENCRYPTION_KEY=changez-moi-32-octets-en-base64-url-safe=
# Écrit dans chaque valeur chiffrée. Pour changer de clé : ajouter la nouvelle,
# déplacer cet identifiant, et garder l'ancienne ci-dessous le temps qu'un
# travail de fond réécrive les valeurs.
TOKEN_ENCRYPTION_KEY_ID=v1
# Clés encore acceptées en déchiffrement, « identifiant:clé » séparés par des virgules.
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Application Meta. Facultatives : sans elles, l'API démarre et le parcours
# Instagram répond 503 plutôt que d'échouer chez Meta avec un message à eux.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:8010/api/v1/social-accounts/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic

# Durée de vie de l'état OAuth, en secondes.
OAUTH_STATE_TTL_SECONDS=600

# Fraîcheur maximale d'un relevé de métriques, en secondes. Sept jours.
METRICS_MAX_AGE_SECONDS=604800

# Intervalle minimal entre deux relevés d'un même compte, en secondes. Une heure.
# Sans lui, un bouton de rafraîchissement dans l'app devient un moyen de nous
# faire bannir de l'API de la plateforme.
METRICS_MIN_REFRESH_INTERVAL_SECONDS=3600

# Seuils de la vérification de cohérence d'un compte social, SPEC.md §3.2.
# Aucun signal n'est en dur dans le code : ce sont ces valeurs qu'on ajustera en
# voyant la file d'administration se remplir.
VERIFICATION_MIN_MEDIA_COUNT=12
VERIFICATION_MAX_FOLLOWERS_PER_MEDIA=2000
VERIFICATION_REGULARITY_WINDOW_DAYS=21
VERIFICATION_MIN_MEDIA_IN_WINDOW=1
VERIFICATION_MIN_ENGAGEMENT_RATE=0.005
VERIFICATION_MAX_ENGAGEMENT_RATE=0.25

# Travail planifie. Le report croissant plafonne et l'arret apres un nombre de
# tentatives sont la seule chose qui empeche un job casse de marteler la
# plateforme d'en face jusqu'a ce qu'elle nous bannisse.
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=300
JOB_RETRY_FACTOR=4
JOB_RETRY_MAX_SECONDS=21600
JOB_ERROR_MAX_LENGTH=500

# Periode du releve planifie, en secondes. Un jour.
METRICS_REFRESH_INTERVAL_SECONDS=86400

# Marge avant expiration en deca de laquelle on renouvelle un jeton. Sept jours :
# les jetons Meta durent soixante jours, et un renouvellement au dernier moment
# ne laisse aucune marge si Meta est indisponible ce jour la.
TOKEN_REFRESH_MARGIN_SECONDS=604800
TOKEN_REFRESH_INTERVAL_SECONDS=86400

# Geocodage. `manual` ne resout rien et rend les coordonnees declarees : c'est le
# mode du developpement, des tests et du jeu de donnees. `geocodio` exige une
# cle, verifiee au demarrage — pas de repli silencieux.
#
# Fournisseur retenu : Geocodio. Pas d'abonnement, facturation a l'appel, pas de
# carte bancaire pour le quota d'essai. Limite : Etats-Unis et Canada seulement,
# ce qui convient au lancement a Miami. Verifier la tarification en vigueur
# avant de passer en production.
GEOCODING_PROVIDER=manual
GEOCODING_API_KEY=
GEOCODING_MIN_ACCURACY=0.8
GEOCODING_TIMEOUT_SECONDS=5.0

# Emails transactionnels. `log` n'envoie rien et trace : c'est le mode du
# developpement et des tests. `resend` exige une cle et un expediteur, verifies
# au demarrage — pas de repli silencieux.
#
# L'expediteur doit relever d'un domaine verifie : un transactionnel envoye
# depuis un domaine non authentifie finit en indesirable, et un rappel qui
# n'arrive pas vaut un rappel qui n'existe pas.
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TIMEOUT_SECONDS=10.0

# Avance du rappel d'echeance, et periode du balayage qui l'envoie.
COLLABORATION_REMINDER_LEAD_SECONDS=21600
COLLABORATION_REMINDER_INTERVAL_SECONDS=3600

# Contrepartie : delai de publication, delai de reprise apres refus, tentatives.
COLLABORATION_PUBLICATION_SECONDS=86400
COLLABORATION_RESUBMIT_SECONDS=43200
COLLABORATION_MAX_ATTEMPTS=3
COLLABORATION_SWEEP_INTERVAL_SECONDS=300

# Fiabilite. Le score part de cette base et bouge avec les ponderations, borne a
# zero et cent. Un ajustement est retroactif : le recalcul relit tout
# l'historique avec la grille du jour, sans migration.
RELIABILITY_BASE_SCORE=70

# Extraction de carte. `manual` n'extrait rien : le commerce saisit sa carte, ce
# qui reste le chemin de la phase 2 et fonctionne parfaitement. `vision` exige
# une cle, verifiee au demarrage.
MENU_EXTRACTION_PROVIDER=manual
MENU_EXTRACTION_API_KEY=
MENU_EXTRACTION_MODEL=claude-sonnet-5
MENU_EXTRACTION_TIMEOUT_SECONDS=60.0

# Inscription sur le terrain. Ou pointe le lien de prise en main remis au salon :
# sans elle, l'emission refuse plutot que de fabriquer une adresse — un lien mort
# est la seule impression que le gerant gardera. Duree de vie a sept jours : le
# gerant qui n'a pas decide au comptoir en parle a son associe, et le lien doit
# survivre a un week-end.
HANDOVER_BASE_URL=
HANDOVER_TOKEN_TTL_SECONDS=604800

# La version des conditions en vigueur. C'est cette chaine-la qui est ecrite au
# journal d'audit a la prise en main, avec l'instant et la personne : un booleen
# « a accepte » ne vaudrait rien le jour ou les conditions changent.
TERMS_VERSION=2026-01

# Periode de grace de l'abonnement. Aucune carte n'est demandee a l'ouverture :
# c'est la friction la plus forte du parcours, et elle arriverait au moment exact
# ou le gerant vient de dire oui. Trente jours pour voir passer des reservations
# et juger sur pieces, sept jours d'avertissement avant l'echeance, un balayage
# par heure.
SUBSCRIPTION_GRACE_PERIOD_SECONDS=2592000
SUBSCRIPTION_GRACE_WARNING_SECONDS=604800
SUBSCRIPTION_GRACE_SWEEP_INTERVAL_SECONDS=3600
