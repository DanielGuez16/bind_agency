# secrets et configuration locale
.env
.env.local
# La configuration de l'environnement de démonstration : identifiants Supabase
# et clés de chiffrement. Le modèle sans valeurs, lui, est versionné.
.env.demo
*.pem

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# node / expo
node_modules/
.expo/
dist/
web-build/
*.log
npm-debug.log*

# Photos de démonstration. Fournies à la main, jamais versionnées : vingt
# fichiers de plusieurs mégaoctets entrent dans l'historique pour toujours, et
# le semis sait s'en passer — il retombe sur ses dégradés générés. La CI et une
# machine fraîche tournent donc sans eux. Seuls la liste et les dossiers vides
# sont suivis, pour que l'arborescence arrive avec le dépôt.
assets/photos/**
!assets/photos/**/
!assets/photos/A-FOURNIR.md
!assets/photos/**/.gitkeep

# macos / ide
.DS_Store
.idea/
*.swp

# Dossiers natifs produits par `expo prebuild`. Ils se regénèrent à la demande
# et n'ont pas à être versionnés tant qu'aucun code natif n'est écrit à la
# main : commités, ils divergeraient de `app.json` sans que rien ne le signale.
app/ios/
app/android/

# Build web produit pour les tests de bout en bout, et leurs artefacts.
app/dist-e2e/
app/test-results/
app/playwright-report/
